#include <iostream>
using namespace std;

int main() {

    int arr[3][3] = {
        {1, 2, 3},
        {4, 8, 2},
        {5, 1, 1}
    };

    int maxSum = 0;
    int maxCol = 0;

    for(int j = 0; j < 3; j++) {

        int sum = 0;

        for(int i = 0; i < 3; i++) {
            sum += arr[i][j];
        }

        if(sum > maxSum) {
            maxSum = sum;
            maxCol = j;
        }
    }

    cout << "Column index with maximum sum: " << maxCol << endl;

    return 0;
}
