#include <iostream>
using namespace std;

int main() {

    int arr[3][3] = {
        {1, 2, 3},
        {4, 5, 6},
        {7, 8, 9}
    };

    // Column Major Traversal
    for(int j = 0; j < 3; j++) {

        for(int i = 0; i < 3; i++) {

            cout << arr[i][j] << " ";

        }
    }

    return 0;
}


// row major 

#include <iostream>
using namespace std;

int main() {

    int arr[3][3] = {
        {1, 2, 3},
        {4, 5, 6},
        {7, 8, 9}
    };

    // Row Major Traversal
    for(int i = 0; i < 3; i++) {

        for(int j = 0; j < 3; j++) {

            cout << arr[i][j] << " ";

        }
    }

    return 0;
}
