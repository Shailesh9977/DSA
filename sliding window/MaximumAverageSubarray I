class Solution {
public:
    double findMaxAverage(vector<int>& nums, int k) {

        int sum = 0;

        // First window
        for (int i = 0; i < k; i++) {
            sum += nums[i];
        }

        int maxSum = sum;

        // Sliding window
        for (int right = k; right < nums.size(); right++) {

            sum += nums[right];        // new element add
            sum -= nums[right - k];    // old element remove

            maxSum = max(maxSum, sum);
        }

        return (double)maxSum / k;
    }
};
