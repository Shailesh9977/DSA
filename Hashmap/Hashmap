//frequency count karna hai 

#include <iostream>
#include <unordered_map>
using namespace std;

int main() {

    int arr[] = {2, 5, 2, 3, 5, 2};

    unordered_map<int, int> mp;

    for(int x : arr) {
        mp[x]++;
    }

    cout << "Frequency of 2: " << mp[2] << endl;
    cout << "Frequency of 5: " << mp[5] << endl;
    cout << "Frequency of 3: " << mp[3] << endl;

    return 0;
}

