//Erase karna hai 


#include <iostream>
#include <unordered_map>
using namespace std;

int main() {

    unordered_map<int, string> mp;

    mp[101] = "Shailesh";
    mp[102] = "Rahul";
    mp[103] = "Aman";

    cout << "Before erase:" << endl;
    cout << "101 -> " << mp[101] << endl;
    cout << "102 -> " << mp[102] << endl;
    cout << "103 -> " << mp[103] << endl;

    // Delete key 102
    mp.erase(102);

    cout << "\nAfter erase:" << endl;
    cout << "101 -> " << mp[101] << endl;
    cout << "103 -> " << mp[103] << endl;

    return 0;
}


// check karke delete karna hai


#include <iostream>
#include <unordered_map>
using namespace std;

int main() {

    unordered_map<int, string> mp;

    mp[101] = "Shailesh";
    mp[102] = "Rahul";
    mp[103] = "Aman";

    if(mp.count(102)) {
        mp.erase(102);
        cout << "102 deleted" << endl;
    }
    else {
        cout << "102 not found" << endl;
    }

    cout << "Remaining elements: " << mp.size() << endl;

    return 0;
}

//traversal


#include <iostream>
#include <unordered_map>
using namespace std;

int main() {

    unordered_map<int, string> mp;

    mp[101] = "Shailesh";
    mp[102] = "Rahul";
    mp[103] = "Aman";

    for(auto x : mp) {
        cout << x.first << " -> " << x.second << endl;
    }

    return 0;
}
